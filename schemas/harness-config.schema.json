{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI.SDLC harness config",
  "type": "object",
  "required": ["project", "surfaces", "packs"],
  "properties": {
    "schema_version": { "type": "integer" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "productName": { "type": "string" }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "filePatterns", "packs"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "filePatterns": { "type": "array", "items": { "type": "string" } },
          "riskClasses": { "type": "array", "items": { "type": "string" } },
          "packs": { "type": "array", "items": { "type": "string" } },
          "skills": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name", "stages"],
                  "properties": {
                    "name": { "type": "string" },
                    "stages": {
                      "type": "array",
                      "items": { "enum": ["Assess", "Regress", "Finish"] },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "jsm": {
      "type": "object",
      "properties": {
        "skillRoots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "commands": { "type": "array", "items": { "type": "string" } },
          "externalProof": { "type": "string" }
        }
      }
    }
  }
}
